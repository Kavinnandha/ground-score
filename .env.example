# Nothing here is required to REPRODUCE results: `make reproduce` replays the
# committed cache with keys stripped from the environment.
#
# A key is only needed to REGENERATE results (`make replies`, `make eval`, ...).

# The judge role defaults to the chain gemini -> ollama, deliberately a
# different vendor from the drafter. Set whichever you intend to use.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Only for scripts/download_data.py, and only if Kaggle starts requiring auth.
# The dataset currently downloads anonymously.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---------------------------------------------------------------------------
# Per-role provider chains. Comma-separated, most preferred first. A role is
# pinned to whichever provider first serves it; a forced switch mid-run is
# warned about and recorded, never silent.
# ---------------------------------------------------------------------------
# GROUNDSCORE_ROLE_FAST=anthropic,ollama    # classify + draft
# GROUNDSCORE_ROLE_JUDGE=gemini,ollama      # reply judge (default)
# GROUNDSCORE_ROLE_CROSS=anthropic,ollama   # self-preference probe
# GROUNDSCORE_PROVIDER=anthropic            # default head for roles with no chain

# Model ids per provider (defaults shown)
# GROUNDSCORE_ANTHROPIC_FAST=claude-haiku-4-5
# GROUNDSCORE_ANTHROPIC_JUDGE=claude-opus-5
# GROUNDSCORE_ANTHROPIC_EFFORT=low
# GROUNDSCORE_MAX_TOKENS=2048
# GROUNDSCORE_MODEL_FAST=qwen3:4b           # ollama
# GROUNDSCORE_MODEL_JUDGE=gemma3:4b         # ollama
# GROUNDSCORE_MODEL_EMBED=nomic-embed-text  # ollama; must match the committed cache
# OLLAMA_HOST=http://localhost:11434

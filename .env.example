# Nothing here is required for the default setup.
#
# The pipeline runs on local models through Ollama (no key, no quota), and
# `make reproduce` replays the committed cache, so a reviewer needs neither.

# Only if you set GROUNDSCORE_PROVIDER=gemini.
GEMINI_API_KEY=

# Only for scripts/download_data.py, and only if Kaggle starts requiring auth.
# The dataset currently downloads anonymously.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Overrides (defaults shown)
# GROUNDSCORE_PROVIDER=ollama
# GROUNDSCORE_MODEL_FAST=qwen3:4b
# GROUNDSCORE_MODEL_JUDGE=gemma3:4b
# GROUNDSCORE_MODEL_EMBED=nomic-embed-text
# OLLAMA_HOST=http://localhost:11434

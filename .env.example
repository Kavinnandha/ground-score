# Nothing here is required to REPRODUCE results: `make reproduce` replays the
# committed cache with keys stripped from the environment.
#
# A key is only needed to REGENERATE results (`make replies`, `make eval`, ...).

# The judge role defaults to the chain gemini -> ollama, deliberately a
# different vendor and family from the drafter, which runs locally.
GEMINI_API_KEY=

# Only for scripts/download_data.py, and only if Kaggle starts requiring auth.
# The dataset currently downloads anonymously.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---------------------------------------------------------------------------
# Per-role provider chains. Comma-separated, most preferred first. A role is
# pinned to whichever provider first serves it; a forced switch mid-run is
# warned about and recorded, never silent. Providers: ollama, gemini.
# ---------------------------------------------------------------------------
# GROUNDSCORE_ROLE_FAST=ollama,gemini     # classify + draft (default: ollama)
# GROUNDSCORE_ROLE_JUDGE=gemini,ollama    # reply judge (default)
# GROUNDSCORE_ROLE_CROSS=ollama           # self-preference probe; must be the drafter
# GROUNDSCORE_PROVIDER=ollama             # default head for roles with no chain

# ---------------------------------------------------------------------------
# Hosted model ids. Chosen on free-tier DAILY budget, not capability: a judged
# split is ~450 calls, *-flash is capped at 20/day, *-flash-lite at 500/day.
# ---------------------------------------------------------------------------
# GROUNDSCORE_GEMINI_FAST=gemini-3.5-flash-lite    # 15 RPM / 500 RPD
# GROUNDSCORE_GEMINI_JUDGE=gemini-3.1-flash-lite   # 15 RPM / 500 RPD
# GROUNDSCORE_GEMINI_JUDGE=gemma-4-31b-it          # 14400 RPD, but 503s under load
# GROUNDSCORE_RPM=0                # 0 = pace per model from the built-in table

# ---------------------------------------------------------------------------
# Local model ids (Ollama). These tags are hashed into the committed response
# cache -- changing one orphans the cached rows that used it.
# ---------------------------------------------------------------------------
# GROUNDSCORE_MODEL_FAST=qwen3:4b           # drafter
# GROUNDSCORE_MODEL_JUDGE=gemma3:4b         # judge fallback
# GROUNDSCORE_MODEL_EMBED=nomic-embed-text  # must match the committed cache
# OLLAMA_HOST=http://localhost:11434
